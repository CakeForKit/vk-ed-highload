
Table users {
  id uuid [pk]
  first_name varchar
  last_name varchar
  birth_date date [note: 'age is calculated when read']
  channel_ids uuid[]  [note: 'список каналов на которыми владеет']
  subscription_ids uuid[] [note: 'список каналов на которые подписан']
  avatar_attachment_key varchar
  revoked_tokens varchar[] [note: 'список отозванных токенов авторизации']
  created_at timestamp
  deleted_at timestamp
}

// облегченная версия таблицы пользователя (чтобы показать данные о пользователе например в списке подписок)
Table user_lite {
  user_id uuid [pk]
  first_name varchar
  last_name varchar
  avatar_attachment_key varchar
}

Table channels {
  id uuid [pk]
  owner_id uuid
  name varchar
  description text
  avatar_attachment_key varchar

  created_at timestamp
  deleted_at timestamp
}

Table subscribtions {
  channel_id uuid
  subscribers user_lite[]

  created_at timestamp
  deleted_at timestamp
}


Table videos {
  id uuid [pk]
  channel_id uuid
  title varchar
  description text
  preview_key varchar
  duration_sec integer
  visibility varchar [note: 'public, private']
  status varchar [note: 'uploading, published, deleted']
  tags varchar[]

  video_variants jsonb [note: 'Данные о вариантах качества видео (480р 720р 1080р и т д) и другая мета с ссылкой на обьектное хранилице']

  views_count bigint
  likes_count bigint
  dislikes_count bigint
  comments_count bigint
  reactions_updated_at timestamp [note: 'не самые актуальные но быстродоступные данные по реакциям пользователей - сюда из video_statistics по job обновляются данные']

  published_at timestamp
  created_at timestamp
}

Table comments {
  id uuid [pk]
  video_id uuid
  user_lite uuid
  parent_comment_id uuid [note: 'null for a top-level comment']
  body text
  created_at timestamp
  deleted_at timestamp
}

Table user_video_interactions {
  user_id uuid [pk]
  view_statistic jsonb[] [note: 'для каждого видео (сделать что то типо мапы [video_id]мета_просмотра): когда смотрел, на какой секунде остановил просмотр и т д']
  reaction_statistic jsob[] [note: 'для каждого видео (сделать что то типо мапы [video_id]мета_ре): лайк, дизлайк и т д']
}

Table video_statistics {
  video_id uuid [pk]
  views_count bigint
  likes_count bigint
  dislikes_count bigint
  comments_count bigint
  updated_at timestamp
}

Table source_video_attachments {
  attachment_key varchar [pk, note: 'source/{hash}/{video_id}/original']
  video_id uuid
  content_type varchar
  size_bytes bigint
  checksum varchar
  created_at timestamp
}

Table streaming_manifests {
  attachment_key varchar [pk, note: 'stream/{hash}/{video_id}/{quality}/{codec}/master.m3u8']
  video_id uuid
  quality varchar
  codec varchar
  size_bytes bigint
  created_at timestamp
}

Table preview_attachments {
  attachment_key varchar [pk, note: 'preview/{hash}/{video_id}/{width}x{height}.jpg']
  video_id uuid
  width integer
  height integer
  size_bytes bigint
  created_at timestamp
}

Table avatar_attachments {
  attachment_key varchar [pk, note: 'avatar/{hash}/{user_id}/{version}.webp']
  user_id uuid
  size_bytes bigint
  created_at timestamp
}

Table multipart_uploads {
  upload_id varchar [pk]
  target_attachment_key varchar
  video_id uuid
  initiated_at timestamp
  expires_at timestamp
  status varchar [note: 'active, completed, aborted']
}

Ref: channels.owner_id > users.id
Ref: subscribtions.subscribers > user_lite.user_id
Ref: subscribtions.channel_id > channels.id


Ref: videos.channel_id > channels.id
Ref: comments.video_id > videos.id
Ref: comments.user_lite > user_lite.user_id
Ref: comments.parent_comment_id > comments.id

Ref: users.channel_ids > channels.id
Ref: users.subscription_ids > channels.id


Ref: user_video_interactions.user_id > users.id
Ref: video_statistics.video_id > videos.id



Table dim_users {
  user_id uuid [pk]
  registered_at timestamp
  birth_date date
  deleted_at timestamp
}

Table dim_channels {
  channel_id uuid [pk]
  owner_user_id uuid
  name varchar
  created_at timestamp
  deleted_at timestamp
}

Table dim_videos {
  video_id uuid [pk]
  channel_id uuid
  title varchar
  duration_sec integer
  visibility varchar
  status varchar
  published_at timestamp
  created_at timestamp
}

Table dim_dates {
  date date [pk]
  year integer
  quarter integer
  month integer
  week integer
  day_of_month integer
  day_of_week integer
}


Table fact_video_views {
  view_id uuid [pk]
  user_id uuid [note: 'NULL для анонимного просмотра']
  video_id uuid
  view_date date

  started_at timestamp
  ended_at timestamp
  watched_sec integer
  last_position_sec integer
  completed boolean
}

Table fact_video_reactions {
  reaction_event_id uuid [pk]
  user_id uuid
  video_id uuid
  reaction_date date

  reaction_type varchar [note: 'like, dislike']
  previous_reaction_type varchar [note: 'like, dislike, null']
  action varchar [note: 'added, changed, removed']
  reacted_at timestamp
}

Ref: dim_channels.owner_user_id > dim_users.user_id
Ref: dim_videos.channel_id > dim_channels.channel_id


Ref: fact_video_views.user_id > dim_users.user_id
Ref: fact_video_views.video_id > dim_videos.video_id
Ref: fact_video_views.view_date > dim_dates.date

Ref: fact_video_reactions.user_id > dim_users.user_id
Ref: fact_video_reactions.video_id > dim_videos.video_id
Ref: fact_video_reactions.reaction_date > dim_dates.date
